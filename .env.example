# Server
PORT=8080
TIMEOUT=30m
# 동시에 Go 코드를 실행할 스레드 수 (미설정 시 1~2). 소형 VM은 1 권장
# GOMAXPROCS=1
# 종료 신호 후 요청을 계속 처리하는 시간
# SHUTDOWN_DELAY=0s
# 종료 시 진행 중인 요청을 기다리는 최대 시간
# SHUTDOWN_TIMEOUT=25s

# TLS (선택사항)
# TLS_CERT=./scripts/cert.pem
# TLS_KEY=./scripts/key.pem

# Auth: none | key | hash
AUTH_MODE=none
# AUTH_KEY=your-secret-key
# AUTH_SECRET=your-hmac-secret
# AUTH_WINDOW=30

# Whitelist (쉼표로 구분, 와일드카드 지원)
# WHITELIST=api.example.com,*.example.org

# Custom headers
HEADER_URL=Yumi-Url
HEADER_METHOD=Yumi-Method
HEADER_PREFIX=Yumi-H-
HEADER_BULK=Yumi-Headers
HEADER_BODY_TRANSFORM=Yumi-Body-Transform
HEADER_AUTH=Yumi-Auth
